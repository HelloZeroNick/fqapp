
import { FlutterAbility, FlutterEngine } from '@ohos/flutter_ohos';
import { GeneratedPluginRegistrant } from '../plugins/GeneratedPluginRegistrant';
import NativePlayerPlugin from '../plugins/NativePlayerPlugin';
import LibraryBackupPlugin from '../plugins/LibraryBackupPlugin';

export default class EntryAbility extends FlutterAbility {
  configureFlutterEngine(flutterEngine: FlutterEngine) {
    super.configureFlutterEngine(flutterEngine)
    GeneratedPluginRegistrant.registerWith(flutterEngine)
    // Hand-written plugin: GeneratedPluginRegistrant.ets is generated by the
    // Flutter tool and must not be edited, so project-local plugins register
    // here instead. It supplies the Flutter texture the libmpv video output
    // renders into (MethodChannel "fqapp/native_player").
    flutterEngine.getPlugins()?.add(new NativePlayerPlugin())
    // Backup import/export over MethodChannel "fqapp/library_backup"; mirrors
    // Android's LibraryBackupPlugin using the OHOS DocumentViewPicker.
    flutterEngine.getPlugins()?.add(new LibraryBackupPlugin())
  }
}
